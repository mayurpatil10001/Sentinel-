# Sentinel .gitignore
# ====================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/

# Testing
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/
*.swp
*.swo

# SQLite databases (dev only)
*.db
*.db-journal
*.db-wal
*.db-shm

# Fyers credentials and tokens (NEVER commit these)
# The token is stored as plain JSON (not encrypted).
# Keep the file at SENTINEL_TOKEN_PATH (default: ~/.sentinel/fyers_token.json)
# or at the repo-root .fyers_token.json — NEITHER path should ever be committed.
.env
.fyers_token.json
data/fyers_token.json
**/fyers_token.json
*.token.json

# Runtime artefacts written during normal operation or tests
# (audit log, calibration output, backtest logs)
# These grow continuously and must not be committed.
runtime/
app/harm_estimation/guard_audit.log
backtest/results/phase8_calibration.log

# Logs
logs/
*.log

# Data cache
data/cache/
*.parquet

# OS
.DS_Store
Thumbs.db

# One-off scripts and screenshots at repo root
fix_redirect.py
fyers_autoauth.py
inspect_dashboard.py
inspect_wl.py
*.png
*.pdf
*.jpg
*.jpeg


Sentinel-premium-frontend/

upgrade_dashboard_ui.py
dashboard/scripts/inject_fyers_modal.py
dashboard/scripts/safe_patch_fyers.py
