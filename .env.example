# Sentinel environment configuration
# =====================================
# Copy this to .env and fill in YOUR values.
# NEVER commit .env to git.
#
# After rotating credentials in the Fyers developer portal:
#   1. Update FYERS_APP_ID and FYERS_SECRET_ID here.
#   2. Run: python get_token.py <new_auth_code>

# Fyers API credentials (obtain from https://myapi.fyers.in/)
FYERS_APP_ID=YOUR_APP_ID_HERE
FYERS_SECRET_ID=YOUR_SECRET_ID_HERE
FYERS_REDIRECT_URI=https://your-redirect-uri.example.com

# Database (default: sentinel_live.db in repo root; demo mode: sentinel_demo.db)
# DATABASE_URL=sqlite:///./sentinel_live.db
# SENTINEL_MODE=live

